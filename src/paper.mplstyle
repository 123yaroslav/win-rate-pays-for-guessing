# Matplotlib style for paper figures. Use with plt.style.use("path/to/paper.mplstyle").
# Draw each figure at its final printed width (6.5 in for a one-column page,
# 3.25 in for one column of a two-column page) so fonts are not scaled afterwards.

# Text. Sans-serif, 8 to 9 pt at print size.
font.family: sans-serif
font.sans-serif: Helvetica, Arial, Liberation Sans, DejaVu Sans
font.size: 8.5
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 7
axes.labelsize: 8.5
axes.labelpad: 3
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.title_fontsize: 8
figure.titlesize: 9
figure.titleweight: bold

# Frame. No top or right spines, thin lines, no grid by default.
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.edgecolor: 333333
axes.labelcolor: 222222
axes.grid: False
grid.color: e6e6e6
grid.linewidth: 0.5
xtick.color: 333333
ytick.color: 333333
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 3
ytick.major.size: 3
xtick.direction: out
ytick.direction: out

# Marks. Okabe-Ito colors, safe for color-blind readers and in grayscale order.
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])
lines.linewidth: 1.5
lines.markersize: 4
patch.linewidth: 0.5
errorbar.capsize: 2
image.cmap: viridis

# Legend. No frame. Prefer direct labels on the marks.
legend.frameon: False
legend.handlelength: 1.5
legend.borderaxespad: 0.3
legend.columnspacing: 1.2

# Layout and output.
figure.figsize: 6.5, 2.4
figure.dpi: 150
figure.facecolor: white
figure.constrained_layout.use: True
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.facecolor: white
savefig.transparent: False

# Embed TrueType fonts so PDFs stay editable and searchable.
pdf.fonttype: 42
ps.fonttype: 42
