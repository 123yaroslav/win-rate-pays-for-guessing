# Builds the slide deck, the project image and the speaker script.
#   make         slides.pdf, card.pdf, project_image.png and talk_notes.md
#   make clean   remove build files, keep the PDFs, the PNG and the script
#
# Result numbers are never typed here. They come from ../paper_A/numbers.tex, and the one
# count that has no macro is read from the sentence in ../paper_A/main.tex (paper_text.tex).

LATEXMK  ?= latexmk
PDFTOPPM ?= pdftoppm
PAPER    := ../paper_A
FIGS     := $(PAPER)/figs/fig1_core.pdf $(PAPER)/figs/fig2_map.pdf
SHARED   := deck.sty paper_text.tex $(PAPER)/numbers.tex

.PHONY: all clean

all: slides.pdf card.pdf project_image.png talk_notes.md

# The count of verdicts on the example duel, in the paper's own words.
paper_text.tex: $(PAPER)/main.tex
	@printf '%% generated by make from $(PAPER)/main.tex, do not edit\n' > $@.tmp
	@sed -n 's/.*With the default instruction, \(.*\) verdicts of the six judges on this duel went to the wrong answer\..*/\\newcommand{\\duelVerdicts}{\1}/p' $< >> $@.tmp
	@grep -q duelVerdicts $@.tmp || { echo "the sentence about the example duel was not found in $<"; rm -f $@.tmp; exit 1; }
	@mv $@.tmp $@

slides.pdf: slides.tex $(SHARED) $(FIGS)
	$(LATEXMK) -pdf -interaction=nonstopmode -halt-on-error slides.tex

card.pdf: card.tex $(SHARED)
	$(LATEXMK) -pdf -interaction=nonstopmode -halt-on-error card.tex

# The page is 160 mm by 90 mm, so 254 dpi gives 1600 by 900 pixels.
project_image.png: card.pdf
	$(PDFTOPPM) -png -r 254 -scale-to-x 1600 -scale-to-y 900 -singlefile card.pdf project_image

# The speaker script with every {{macro}} replaced by its value.
talk_notes.md: talk_notes.src.md fill.awk $(PAPER)/numbers.tex paper_text.tex
	awk -f fill.awk $(PAPER)/numbers.tex paper_text.tex talk_notes.src.md > $@.tmp
	@mv $@.tmp $@

clean:
	$(LATEXMK) -c slides.tex
	$(LATEXMK) -c card.tex
	rm -f slides.nav slides.snm card.nav card.snm
